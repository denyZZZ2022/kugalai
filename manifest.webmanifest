{
  "id": "./",
  "name": "KLUG Sound — музыка внутри KlugAI",
  "short_name": "KLUG Sound",
  "description": "Музыкальный плеер внутри Telegram: поиск треков и исполнителей, полные треки Audius и превью Apple Music, очередь и любимые песни.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "./player.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07080b",
  "theme_color": "#07080b",
  "categories": ["music", "entertainment"],
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Поиск музыки",
      "short_name": "Поиск",
      "description": "Найти треки и исполнителей",
      "url": "./player.html#/search",
      "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Любимые треки",
      "short_name": "Любимые",
      "description": "Открыть сохранённую коллекцию",
      "url": "./player.html#/liked",
      "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
